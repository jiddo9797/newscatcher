# 이 파일은 "어떤 비밀 값이 필요한지" 알려 주는 예시예요. 실제 값은 넣지 마세요.
# 실제 값은 .env.local에 넣어요. (.env.local은 GitHub에 올라가지 않음)
# 배포할 때는 같은 값을 Vercel → Settings → Environment Variables에 넣어요.

# Google Gemini API 키 (https://aistudio.google.com 에서 발급)
GEMINI_API_KEY=

# 아래 세 값은 `npm run setup-secrets`를 실행하면 자동으로 만들어져요.
APP_PASSWORD_HASH=   # 로그인 비밀번호의 해시 (원문 아님)
SESSION_SECRET=      # 로그인 쿠키 서명용 무작위 값
CRON_SECRET=         # 매일 아침 자동 실행 주소 보호용 무작위 값

# 배포 환경에서 Vercel이 Neon DB를 연결하면 자동으로 들어가요. 내 컴퓨터에서는 비워 두면 PGlite를 써요.
# DATABASE_URL=
